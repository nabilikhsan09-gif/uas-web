# Salin file ini menjadi .env dan sesuaikan dengan kredensial lokal kamu.

SECRET_KEY=ganti-dengan-string-acak-yang-panjang

# Koneksi ke database MySQL lokal (XAMPP/Laragon/phpMyAdmin), sesuai sipemas.sql
# Format: mysql+pymysql://USER:PASSWORD@HOST:PORT/NAMA_DATABASE
#
# Default XAMPP/Laragon biasanya user "root" tanpa password:
DATABASE_URL=mysql+pymysql://root:@localhost:3306/sipemas

# Saat deploy ke Vercel, WAJIB ganti dengan connection string dari layanan
# database online (misalnya filess.io) — Vercel tidak bisa mengakses
# "localhost" milik komputer kamu. Contoh:
# DATABASE_URL=mysql+pymysql://user:password@host:port/nama_database

# WAJIB diisi saat deploy ke Vercel (filesystem Vercel tidak permanen, jadi
# foto pengaduan harus disimpan di Cloudinary, bukan di static/uploads).
# Daftar gratis di https://cloudinary.com -> Dashboard -> salin nilai
# "API Environment variable" (formatnya: cloudinary://API_KEY:API_SECRET@CLOUD_NAME)
CLOUDINARY_URL=
